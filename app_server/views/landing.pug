extends layout

block content
    .row.banner
        .col-12
            h1=pageHeader.title
            p.lead=pageHeader.strapline
    .row
        .col-12.col-md-8
            h2 How it works
            p
                | Work Experience Tracker helps students manage applications for work experience, internships, shadowing opportunities and placements.
            ul
                each feature in features
                    li=feature
            p
                a.btn.btn-primary(href='/register') Get started
                | &nbsp;
                a.btn.btn-default(href='/login') Login
        .col-12.col-md-4
            .panel.panel-default
                .panel-heading
                    h3.panel-title=sidebar.title
                .panel-body
                    p=sidebar.text