extends layout

block content
    .row.banner
        .col-12
            h1 Work Experience Tracker
            p.lead Track your work experience applications in one place
    .row
        .col-12.col-md-8
            h2 How it works
            p
                | Work Experience Tracker helps students manage applications for work experience, internships, shadowing opportunities and placements.
            ul
                li Register a free account
                li Add companies you've applied to
                li Track position, application type, status, date applied, interview date and CV used
                li See everything in one dashboard
            p
                a.btn.btn-primary(href='/register') Get started
                | &nbsp;
                a.btn.btn-default(href='/login') Login
        .col-12.col-md-4
            .panel.panel-default
                .panel-heading
                    h3.panel-title Why use it?
                .panel-body
                    p
                        | Never lose track of an application again. See deadlines, interview dates and follow-ups at a glance.